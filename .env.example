# Copy to .env and set the API key locally. Never commit .env.
LLM_PROVIDER=openai_compatible
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=90

# Context and runtime budgets
CONTEXT_WINDOW=128000
OUTPUT_TOKEN_RESERVE=8192
CONTEXT_SAFETY_MARGIN=1024
CONTEXT_COMPACTION_TRIGGER_RATIO=0.72
CONTEXT_COMPACTION_TARGET_RATIO=0.52
CONTEXT_RECENT_BLOCKS_TO_KEEP=2
CONTEXT_TOOL_RESULT_MAX_CHARS=4000
CONTEXT_SUMMARY_MAX_INPUT_TOKENS=8000
CONTEXT_SUMMARY_MAX_OUTPUT_TOKENS=800
CONTEXT_SUMMARY_TIMEOUT_SECONDS=30
RUN_MAX_TURNS=12
RUN_MAX_TOOL_CALLS=32
RUN_WALL_TIME_SECONDS=600

# Tool execution limits
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RESULT_BYTES=32768
TOOL_MAX_CONCURRENCY=4

# External MCP servers. Copy mcp_servers.example.yaml to this path to enable them.
MCP_CONFIG_PATH=mcp_servers.yaml
MCP_DISCOVERY_TIMEOUT_SECONDS=15
MCP_SCHEMA_CACHE_TTL_SECONDS=300

# Per-session UI workspace (files are never injected into model context automatically)
WORKSPACE_ROOT=.data/workspaces
WORKSPACE_MAX_FILE_BYTES=26214400
LOG_ROOT=.data/logs

# Durable anonymous conversation history. Relative paths resolve from the app root.
HISTORY_DB_PATH=.data/agent_history.db
HISTORY_BUSY_TIMEOUT_MS=5000
ANON_COOKIE_NAME=agent_anon
ANON_COOKIE_MAX_AGE_DAYS=30
# Set true behind HTTPS. Local HTTP development may keep this false.
ANON_COOKIE_SECURE=false
ANON_COOKIE_HTTP_ONLY=true
ANON_COOKIE_SAME_SITE=lax

# Optional Python/API callers. Generate each key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Multiple callers can use comma-separated keys; each key owns separate task and conversation history.
AGENT_API_KEYS=

# OpenCode-compatible Skills. Project Skills default to script approval required.
SKILL_PROJECT_ROOT=.
SKILL_GLOBAL_CONFIG_ROOT=~/.config
SKILL_SCRIPT_POLICY=ask
SKILL_LOAD_POLICY=allow
SKILL_ALLOWED_EXTENSIONS=.py,.sh
SKILL_SCRIPT_TIMEOUT_SECONDS=30
SKILL_SCRIPT_MAX_TIMEOUT_SECONDS=120
SKILL_SCRIPT_MAX_OUTPUT_BYTES=65536
SKILL_MAX_CONCURRENT_SCRIPTS_PER_RUN=2
